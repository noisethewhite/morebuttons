{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2020",
    "module": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "moduleResolution": "nodenext"
  },
  "include": ["./src/frontend/*"]
}